From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DM3KS <sku2atsc@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:15:08 +0200
Subject: [PATCH 2/2] Sperrliste: Voreinstellung NF0JN einmalig, wenn noch nie
 eine Liste gespeichert war

---
 src/blocked_calls.cpp | 53 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 52 insertions(+), 1 deletion(-)

diff --git a/src/blocked_calls.cpp b/src/blocked_calls.cpp
index b50679ab..cb8506ae 100644
--- a/src/blocked_calls.cpp
+++ b/src/blocked_calls.cpp
@@ -355,6 +355,11 @@ static void printDropped(const char *entry)
     Serial.printf("[BLOCK];load;dropped;%s\n", entry);
 }
 
+// DM3KS-Fork: Voreinstellung fuer Knoten, auf denen noch NIE eine Sperrliste
+// gespeichert wurde. Sie wird einmalig gesetzt UND gespeichert; danach gilt nur
+// noch die gespeicherte Liste (auch eine bewusst geleerte).
+#define BLOCKLIST_FORK_DEFAULT "NF0JN"
+
 static void applyLoaded(const char *raw)
 {
     char tmp[BLOCKLIST_CSV_MAX];
@@ -372,6 +377,26 @@ static void applyLoaded(const char *raw)
 static const char kBlockNs[] = "blocklist";
 static const char kBlockKey[] = "block_list";
 
+// DM3KS-Fork: Merker "Voreinstellung erledigt". Wird gesetzt, sobald einmal
+// irgendeine Liste gespeichert war -- danach wird nie wieder vorbelegt.
+static void forkMarkSeeded()
+{
+    Preferences seed;
+    seed.begin(kBlockNs, false);
+    if (seed.getUChar("fork_seeded", 0) == 0)
+        seed.putUChar("fork_seeded", 1);
+    seed.end();
+}
+
+static bool forkSeeded()
+{
+    Preferences seed;
+    seed.begin(kBlockNs, false);
+    bool r = seed.getUChar("fork_seeded", 0) != 0;
+    seed.end();
+    return r;
+}
+
 void blockListLoad()
 {
     Preferences prefs;
@@ -393,8 +418,22 @@ void blockListLoad()
         if (legacy && blockListSave())
             prefs.remove(kBlockKey);
         prefs.end();
+        if (legacy)
+            forkMarkSeeded();
+        else if (!forkSeeded())
+        {
+            // DM3KS-Fork: noch nie gespeichert -> Voreinstellung einmalig
+            // setzen und speichern.
+            applyLoaded(BLOCKLIST_FORK_DEFAULT);
+            if (blockListSave())
+            {
+                forkMarkSeeded();
+                Serial.printf("[BLOCK];load;default;%s\n", BLOCKLIST_FORK_DEFAULT);
+            }
+        }
         return;
     }
+    forkMarkSeeded();
     applyLoaded(v.c_str());
 }
 
@@ -424,7 +463,8 @@ void blockListLoad()
     File f(InternalFS);
     char buf[sizeof(kBlockMagic) + BLOCKLIST_CSV_MAX + 64];
     size_t n = 0;
-    if (f.open(kBlockFile, FILE_O_READ))
+    bool exists = f.open(kBlockFile, FILE_O_READ);
+    if (exists)
     {
         n = f.read((uint8_t *)buf, sizeof(buf) - 1);
         f.close();
@@ -432,7 +472,18 @@ void blockListLoad()
     buf[n] = 0;
     const size_t ml = sizeof(kBlockMagic) - 1;
     if (n < ml || strncmp(buf, kBlockMagic, ml) != 0)
+    {
+        // DM3KS-Fork: Datei fehlt = noch nie gespeichert -> Voreinstellung
+        // einmalig setzen und speichern (eine geleerte Liste ist eine
+        // vorhandene Datei "BLK1:" und bleibt leer).
+        if (!exists)
+        {
+            applyLoaded(BLOCKLIST_FORK_DEFAULT);
+            if (blockListSave())
+                Serial.printf("[BLOCK];load;default;%s\n", BLOCKLIST_FORK_DEFAULT);
+        }
         return;   // absent or foreign file: stay empty
+    }
     applyLoaded(buf + ml);
 }
 
