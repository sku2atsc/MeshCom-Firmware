From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DM3KS <sku2atsc@users.noreply.github.com>
Date: Sat, 31 Oct 2026 08:24:32 +0100
Subject: [PATCH] Auto-Update: Kanal dev auf sku2atsc/MeshCom-Firmware (DM3KS),
 Voreinstellung dev

---
 src/command_functions.cpp           | 2 +-
 src/fw_update.h                     | 2 +-
 src/meshcom_settings.h              | 2 +-
 src/web_functions/web_functions.cpp | 2 +-
 test/test_fw_update/test_main.cpp   | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/command_functions.cpp b/src/command_functions.cpp
index ef8f9148..50b1531b 100644
--- a/src/command_functions.cpp
+++ b/src/command_functions.cpp
@@ -842,7 +842,7 @@ static void cmdPosRange(const char *label, const char *range, const char *msg_te
 
 // --help text of --updchan: the dev channel exists only in fork builds (fw_update.h)
 #if defined(MC_AU_DEV_CHANNEL)
-#define AU_UPDCHAN_HELP "prod/dev       update source: prod icssw-org, dev DK5EN"
+#define AU_UPDCHAN_HELP "prod/dev       update source: prod icssw-org, dev DM3KS"
 #else
 #define AU_UPDCHAN_HELP "prod           update source: icssw-org releases"
 #endif
diff --git a/src/fw_update.h b/src/fw_update.h
index e6479295..94c820ab 100644
--- a/src/fw_update.h
+++ b/src/fw_update.h
@@ -220,7 +220,7 @@ inline const char *fwChannelRepo(FwChannel c)
 {
 #if FW_HAS_DEV_CHANNEL
     if (c == FW_CH_DEV)
-        return "DK5EN/MeshCom-Firmware";
+        return "sku2atsc/MeshCom-Firmware";   // DM3KS-Fork: dev-Kanal auf diesen Fork
 #endif
     (void)c;
     return "icssw-org/MeshCom-Firmware";
diff --git a/src/meshcom_settings.h b/src/meshcom_settings.h
index 377dbcf0..2fb4f6c5 100644
--- a/src/meshcom_settings.h
+++ b/src/meshcom_settings.h
@@ -207,7 +207,7 @@
     /* mapped to 1 by sanitize_loaded_settings(). Default notify on ESP32, 0 on nRF52 (no AU there). Persisted; console rung ESP32 only. */ \
     M(int, node_autoupd, MC_PLATFORM_DEFAULT(1, 0))                                                      \
     /* AU-03 (#1187): update channel, 0 prod (icssw-org) / 1 dev (DK5EN); default 0. Persisted. */           \
-    M(int, node_updchan, 0)                                                                              \
+    M(int, node_updchan, 1)   /* DM3KS-Fork: Voreinstellung dev (= dieser Fork) */                      \
     /* gateway registration state (src/gw_reg_runtime.cpp): flag + callsign at entry. Persisted, not exported. */ \
     M(int, node_gwrf, 0)                                                                                 \
     A(char, node_gwrc, [10], {0})
diff --git a/src/web_functions/web_functions.cpp b/src/web_functions/web_functions.cpp
index 7ab10ab0..869f43ae 100644
--- a/src/web_functions/web_functions.cpp
+++ b/src/web_functions/web_functions.cpp
@@ -3579,7 +3579,7 @@ void sub_page_setup()
         // D3: notify (prod), notify (dev), auto greyed. A console-set auto shows greyed and selected.
         web_client.printf("\t<option value=\"prod\" %s>notify (prod, icssw-org releases)</option>\n", (au_mode != 2 && au_chan == 0) ? "selected" : "");
 #if defined(MC_AU_DEV_CHANNEL)   // dev channel: fork builds only (fw_update.h)
-        web_client.printf("\t<option value=\"dev\" %s>notify (dev, DK5EN releases)</option>\n", (au_mode != 2 && au_chan == 1) ? "selected" : "");
+        web_client.printf("\t<option value=\"dev\" %s>notify (dev, DM3KS releases)</option>\n", (au_mode != 2 && au_chan == 1) ? "selected" : "");
 #endif
         web_client.printf("\t<option value=\"auto\" disabled %s>auto (coming soon)</option>\n", (au_mode == 2) ? "selected" : "");
         web_client.println("</select>");
diff --git a/test/test_fw_update/test_main.cpp b/test/test_fw_update/test_main.cpp
index ec56526c..053ed419 100644
--- a/test/test_fw_update/test_main.cpp
+++ b/test/test_fw_update/test_main.cpp
@@ -210,7 +210,7 @@ static void test_channel_repos(void)
     TEST_ASSERT_EQUAL_STRING("icssw-org/MeshCom-Firmware", fwChannelRepo(FW_CH_PROD));
 #if defined(MC_AU_DEV_CHANNEL)
     TEST_ASSERT_EQUAL_INT(1, FW_HAS_DEV_CHANNEL);
-    TEST_ASSERT_EQUAL_STRING("DK5EN/MeshCom-Firmware", fwChannelRepo(FW_CH_DEV));
+    TEST_ASSERT_EQUAL_STRING("sku2atsc/MeshCom-Firmware", fwChannelRepo(FW_CH_DEV));
 #else
     // native_fw_update_prod, the upstream build: no dev channel, a stored dev reads prod
     TEST_ASSERT_EQUAL_INT(0, FW_HAS_DEV_CHANNEL);
